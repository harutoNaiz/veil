<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Phase 4.3.1 (A1): debug-only isolated host for the overlay. -->
        <service
            android:name=".overlay.OverlayAccessibilityService"
            android:exported="true"
            android:label="@string/overlay_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/overlay_accessibility_service" />
        </service>
        <activity
            android:name=".replay.ReplayActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".bench.BenchActivity"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
    </application>
</manifest>
