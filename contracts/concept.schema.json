{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Concept",
  "description": "The user-facing definition of one dislike: the concept card's words, lookalikes and settings. Veil contract v1.0. Units: positions and sizes are integer screen pixels with the origin at the top-left of the display in its current orientation (x grows right, y grows down); times are integer milliseconds on one monotonic clock (Android SystemClock.uptimeMillis; replays use a virtual clock in the same unit); fingerprints are L2-normalised vectors stored as float16.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Contract version this object follows."
    },
    "conceptId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Stable identifier of the concept."
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Name shown to the user."
    },
    "layer": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "description": "1 is the always-on safety layer, 2 is the user's own list."
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether the concept is switched on."
    },
    "looksLike": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "maxItems": 32,
      "description": "Words describing what to hide."
    },
    "butNot": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 32,
      "description": "Lookalikes that must not be hidden."
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 16,
      "description": "Things to ignore; when omitted the Teacher uses the shared ignore list."
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minItems": 0,
      "maxItems": 64,
      "description": "Keyword rules for the text lane."
    },
    "examplePhotos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExamplePhoto"
      },
      "minItems": 0,
      "maxItems": 16,
      "description": "Example photos plus their checksums."
    },
    "scope": {
      "type": "string",
      "enum": [
        "object",
        "wholeElement"
      ],
      "description": "Cover only the object, or the whole element around it."
    },
    "coverStyle": {
      "type": "string",
      "enum": [
        "solid",
        "blur",
        "mosaic"
      ],
      "description": "How the cover looks. Layer 1 is always solid."
    },
    "showLabel": {
      "type": "boolean",
      "description": "Whether the cover shows a label."
    },
    "strictness": {
      "type": "string",
      "enum": [
        "light",
        "balanced",
        "strict"
      ],
      "description": "A per-concept override; when omitted the global mode applies."
    },
    "sensitive": {
      "type": "boolean",
      "description": "True for sensitive topics (hidden from previews)."
    }
  },
  "required": [
    "contractVersion",
    "conceptId",
    "displayName",
    "layer",
    "enabled",
    "looksLike",
    "butNot",
    "scope",
    "coverStyle",
    "showLabel"
  ],
  "if": {
    "properties": {
      "layer": {
        "const": 1
      }
    },
    "required": [
      "layer"
    ]
  },
  "then": {
    "properties": {
      "coverStyle": {
        "const": "solid"
      }
    }
  },
  "$defs": {
    "ExamplePhoto": {
      "title": "ConceptExamplePhoto",
      "description": "One example photo that the user supplied for a concept.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "description": "File path of the photo."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the file."
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    }
  }
}
