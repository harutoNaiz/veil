{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecordingLabel",
  "type": "object",
  "additionalProperties": false,
  "required": ["labelVersion", "sessionId", "durationMs", "screenWidth", "screenHeight", "labeller", "reviewedBy", "tracks", "marks", "clean"],
  "properties": {
    "labelVersion": {"const": "1"},
    "sessionId": {"type": "string", "minLength": 1},
    "durationMs": {"type": "integer", "minimum": 0},
    "screenWidth": {"type": "integer", "minimum": 1},
    "screenHeight": {"type": "integer", "minimum": 1},
    "labeller": {"type": "string"},
    "reviewedBy": {"type": ["string", "null"]},
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
    "marks": {"type": "array", "items": {"$ref": "#/$defs/mark"}},
    "clean": {"type": "array", "items": {"$ref": "#/$defs/span"}}
  },
  "$defs": {
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}, "w": {"type": "integer", "minimum": 0}, "h": {"type": "integer", "minimum": 0}}
    },
    "span": {
      "type": "object", "additionalProperties": false, "required": ["startMs", "endMs"],
      "properties": {"startMs": {"type": "integer"}, "endMs": {"type": "integer"}}
    },
    "keyframe": {
      "type": "object", "additionalProperties": false, "required": ["tMs", "rect"],
      "properties": {"tMs": {"type": "integer"}, "rect": {"$ref": "#/$defs/rect"}}
    },
    "track": {
      "type": "object", "additionalProperties": false, "required": ["key", "conceptId", "spans", "keyframes"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "conceptId": {"type": "string", "minLength": 1},
        "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
        "keyframes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/keyframe"}}
      }
    },
    "mark": {
      "type": "object", "additionalProperties": false, "required": ["tMs", "type"],
      "properties": {"tMs": {"type": "integer"}, "type": {"enum": ["sceneCut", "appSwitch", "lock", "unlock"]}}
    }
  }
}
